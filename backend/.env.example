# Copy to .env and fill in real values for anything beyond local dev.
# `config.py` automatically loads `.env` (via python-dotenv).
# Every var below is read in config.py; that file's inline comments explain
# what each default means and whether it's safe to leave as-is.

# ── Platform / Headless Mode ────────────────────────────────────────────────
PPE_HEADLESS=false
PPE_PLATFORM_CAMERA_IDS=

# ── Postgres (plain postgresql:// scheme, not +asyncpg) ─────────────────────
PPE_DATABASE_URL=postgresql://ppe:ppe@localhost:5432/ppe_compliance

# ── Redis (frames:{camera_id}, events:ppe/events:compliance) ───────────────
# Local dev default has no auth. For a real deployment, set BOTH of these
# together — PPE_REDIS_PASSWORD only configures the docker-compose container;
# PPE_REDIS_URL is what the app actually connects with and must itself carry
# the password (and ideally TLS: rediss://... on a TLS-terminated Redis).
PPE_REDIS_URL=redis://localhost:6379/0
PPE_REDIS_PASSWORD=

# ── MinIO (evidence snapshot storage) ───────────────────────────────────────
PPE_MINIO_ENABLED=false
PPE_MINIO_ENDPOINT=localhost:9000
PPE_MINIO_ACCESS_KEY=ppe-minio
PPE_MINIO_SECRET_KEY=ppe-minio-secret
PPE_MINIO_BUCKET=uc3-evidence
PPE_MINIO_SECURE=false
PPE_SNAPSHOT_RETENTION_DAYS=90

# ── Camera Registry Service (platform-owned; unset = local cameras table only) ──
PPE_CAMERA_REGISTRY_URL=
PPE_CAMERA_REGISTRY_API_KEY=
PPE_CAMERA_REGISTRY_SYNC_INTERVAL_SECONDS=300

# ── Auth ─────────────────────────────────────────────────────────────────────
# MUST be overridden for anything beyond local dev — see config.py's comment.
PPE_JWT_SECRET=dev-only-insecure-secret-change-me
PPE_ADMIN_BOOTSTRAP_EMAIL=admin@innovision.com
PPE_ADMIN_BOOTSTRAP_PASSWORD=

# ── SMTP (defaults target the mailhog dev container, no real delivery) ─────
PPE_SMTP_HOST=localhost
PPE_SMTP_PORT=1025
PPE_SMTP_USERNAME=
PPE_SMTP_PASSWORD=
